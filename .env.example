# Copy to .env and adjust as needed. All vars are prefixed RAG_ (see src/rag_platform/config.py).
# Note: company_id is normally passed via --company on the CLI, not set here —
# these are process-wide defaults, mainly useful for the "default" tenant.

RAG_MAX_PDF_WORKERS=4

RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_MIN_CHUNK_LENGTH=100

RAG_EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_DEVICE=cpu

RAG_RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_OLLAMA_MODEL=llama3.1:8b

# Voice input (optional) — free tier at https://console.groq.com/keys
# Note: plain GROQ_API_KEY (no RAG_ prefix) also works, matching Groq's own
# SDK convention, so you don't need a project-specific env var name.
GROQ_API_KEY=

# Caching (in-memory, per process — no Redis needed at this scale)
RAG_CACHE_TTL_SECONDS=3600
RAG_CACHE_MAX_ENTRIES=256
